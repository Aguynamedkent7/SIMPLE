# Supabase project settings (Dashboard → Project Settings → API). Server-only: the browser never
# talks to Supabase directly, so these are deliberately not NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile site key. Read on the server and handed to the widget per request, so
# nothing is baked into the JS bundle. The matching secret goes in the Supabase dashboard
# (Authentication → Attack Protection), never here. Leave empty locally: local Auth has CAPTCHA off.
TURNSTILE_SITE_KEY=

# Never add a service role / secret key. The build refuses to run if one is set.
